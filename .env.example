# Same keys the ai-education-admin frontend reads, so one .env serves both.
VITE_API_BASE_URL=https://stagingaibackend.oswaal360.com
VITE_X_API_KEY=<x-api-key>

# Bearer token for image uploads. The admin frontend gets this from the
# `authToken` cookie at login; a Streamlit app has no cookie, so either
# paste a token here OR set the username/password below to have one
# minted automatically via POST /api/v1/login.
# OSWAAL_API_TOKEN=<bearer token>
OSWAAL_USERNAME=<username>
OSWAAL_PASSWORD=<password>
